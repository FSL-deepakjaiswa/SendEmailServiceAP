{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "EmailDB": "Server=.;Database=YourDatabase;Trusted_Connection=true;TrustServerCertificate=true;"
